                ajaxUrl = goDataAPIurl + "/TripLocation/Service/IncludeEquipmentTrip/IsPublic/Lang/" + serviceId + "/" + includeEquipmentTrip + "/" + isPublic + "/" + lang ;
            else {
                // Replace single serviceId with 7 fixed services and merge all returned XML entries under <Data>
                ajaxUrl = null;
                multiServiceLangCall = true;
            }
        }
    }
    else{
        if (hastusTripId != ''){
            tripId = hastusTripId;
        }
        ajaxUrl = goDataAPIurl + "/TripLocation/Service/TripNum/Lang/" + serviceId + "/" + tripId + "/" + lang;
