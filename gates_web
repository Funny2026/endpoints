function getStationStatusInfo(stationName, lstationId, lstopCd) {
    var stationInfoUrl = 'https://www.gotransit.com/en/find-a-station-or-stop/';
    var targetStr = '_blank';
    if (staticStationMap){
        stationInfoUrl += lstationId;
        targetStr = '_self';
    }else
        stationInfoUrl += lstopCd;

    var ajaxUrl = goDataAPIurl + "/StationStatus/" + lstationId;
    var nodeName = 'StationStatus';
    var contentTxt = '<span class="tripLabel" style="display:block;" ><table class="stbl" style="width:100%;"><tr><td style="background-color: #7388a5; color: white;">' + stationName + '</td></tr><tr><td><a href="' + stationInfoUrl + '" target="' + targetStr + '">Station Info</a></td></tr><tr><td>';

    var req = $.ajax({
        type: "GET",
        url: ajaxUrl,
        dataType: "xml",
        cache: false,
        async: false,
        timeout: 30000,
        success: function (data, textStatus, XMLHttpRequest) {
            var noTripKey = 'NoTrip_';
            var destination;
            var schedule;
            var delay;
            var statusTblContext;
            var tripCount = 0;

            var err = $(data).find("ErrMsg").text();
            if (err == ""){
                var result = $(data).find(nodeName);
                if (result.length > 0){
                    statusTblContext = '<table class="stbl" style="width:99%;"><tr class="tblHeader stbl"><td class="stbl" align="left">Destination</td><td class="stbl" align="center">Scheduled</td><td class="stbl" align="center">Delay</td></tr>';
                    result.each(function () {
                        var tripId = $(this).attr('TripNumber');
                        var noTripCount = tripId.search(noTripKey);
                        if (noTripCount < 0){
                            if (tripCount < 3){                                
                                delay = 0;
                                destination = $(this).attr('Destination');
                                schedule = $(this).attr('ScheduledTime');
                                try {
                                    delay = parseInt($(this).attr('Delay'));
                                } catch (e) { }
                                statusTblContext += '<tr class="stopStatus stbl"><td class="stbl" align="left">' + destination + '</td><td class="stbl" align="center">' + schedule + '</td><td class="stbl" align="center">' + delay + '</td></tr>';
                                tripCount++;
                            }
                        }
                    });
                }
                statusTblContext += '</table></td></tr></table>';
            }
            if (tripCount > 0)
                contentTxt += statusTblContext;
        },
        error: function (data, textStatus, XMLHttpRequest) {
            var errStr = "Error requesting station data";
            $("err").text(errStr);
//            if (raiseError != undefined && raiseError != null){
//                raiseError(errStr);
//            }
            data = null;
            XMLHttpRequest = null;
            textStatus = null;
        }
    });
    contentTxt += '</span>';
    return contentTxt;
}

function fetchTripLocationsForServices(serviceIds, lang) {
    const urlBase = goDataAPIurl + "/TripLocation/Service/Lang/";
    return Promise.allSettled(
        serviceIds.map((svc) => {
            return $.ajax({
                type: "GET",
                url: urlBase + svc + "/" + lang,
                dataType: "xml",
                cache: false,
                async: true,
                timeout: 30000
            });
        })
    ).then((results) => {
        const xmlDocs = (results || []).filter(r => r.status === 'fulfilled').map(r => r.value);
        if (!xmlDocs || xmlDocs.length === 0) return null;

        const baseDoc = xmlDocs[0];
        const baseDataNode = baseDoc.getElementsByTagName('Data')[0];
        if (!baseDataNode) return baseDoc;

        // Clear existing Data children
        while (baseDataNode.firstChild) baseDataNode.removeChild(baseDataNode.firstChild);

        xmlDocs.forEach((xmlDoc) => {
            if (!xmlDoc || !xmlDoc.getElementsByTagName) return;
            const dataNode = xmlDoc.getElementsByTagName('Data')[0];
            if (!dataNode) return;

            Array.from(dataNode.childNodes).forEach((child) => {
                const imported = (baseDoc.importNode) ? baseDoc.importNode(child, true) : child.cloneNode(true);
                baseDataNode.appendChild(imported);
            });
        });

        return baseDoc;
    });
}

function moveAllObj(moveMode) {
    var ajaxUrl;
