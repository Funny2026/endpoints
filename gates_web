                        mapTripCurrentErrorCount = 0;
                        setTimeout(function(){isAjaxReturned = true;}, mapTripErrorRetryInterval);
                    }
                    else
                    {
                        mapTripCurrentErrorCount++;
                        isAjaxReturned = true;
                    }
               }
               else
