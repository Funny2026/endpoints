function formatStop(seconds, move, memo){
    const m = Math.floor(Math.abs(seconds) / 60);
    const s = Math.abs(seconds) % 60;
    let resultStr = "";

    if (seconds == 0) {
        resultStr = "On time";
    }

    if (seconds > -60 && seconds < 60 && seconds != 0) {
        resultStr = `${s} sec${s == 1 ? "" : "s"}`;
    } else if (seconds != 0){
        resultStr = `${m} min${m == 1 ? "" : "s"} ${s} sec${s == 1 ? "" : "s"}`;
    }
    if (seconds < 0) {
        resultStr = "Early " + resultStr;
    }
   resultStr += move ? " / Moving" : " / Stopped";
   if (memo) {
	   resultStr += "<br>" + memo;
   }
  return "<br>" + resultStr;
}
	
function SetTripContent(vMarker, speedStr, speed, tripNum, tripName, routeName){
    vMarker.marker.setTitle(replaceAll(routeName, '<hr/>', '\r\n\r\n'));

    var routeNameBR = routeName.replace(/(\r\n|\n|\r)/gm, htmlBR);
    var strContent = '<span class="tripLabel">' + htmlBR + routeNameBR + '</span>';

    if (vMarker.InfoWindow == null){
        trace('Info Window created for trip: ' + vMarker.key);
        vMarker.InfoWindow = new google.maps.InfoWindow({
            content: strContent
        });

        vMarker.InfoWindowListener = google.maps.event.addListener(vMarker.marker, "click", function () {
            vMarker.InfoWindow.open(map, vMarker.marker);
        });
    }
    else{
        vMarker.InfoWindow.setContent(strContent);
    }
    delete routeNameBR;
    delete strContent;
}

