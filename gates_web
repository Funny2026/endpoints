<script type="text/javascript">
let codesData;
let isLoaded = false;
let lastSyncedTime;
let deltaSeconds = -1;
class Dashboard {
    constructor() {
        this.lockedStationsPage = 0;
        this.delayPage = 0;
        this.pageSize = 6;
        this.cycleTime = 5000;
        this.refreshInterval = 1000;

        this.lockedStations = [];
        this.vehicleDelays = [];
        this.alllockedStationVehicleIds = [];

        // flag to indicate whether a fetch cycle is in progress
        this.fetchInProgress = false;

        // indicates whether initial main files have finished loading
        this.initialLoaded = false;

        // indicates whether automatic cycling has been started
        this.cyclingStarted = false;

        this.init();
    }

    async init() {
        // show loading text immediately on both panels until first successful main load
        // Do NOT start cycling yet — wait until the initial main files have loaded
        this.refreshLoop();
    }

    async refreshLoop() {
        while (true) {
            if (!this.fetchInProgress) {
                await this.loadAndProcess();
            }
            await new Promise(resolve => setTimeout(resolve, this.refreshInterval));
        }
    }

    async loadAndProcess() {
        this.fetchInProgress = true;
        try {
            // Step 1: Load main files
            const [LW, LE, BR, GT, ST, RH, MI, tripCodes] = await Promise.all([
            fetchData('https://www.gotracker.ca/gotracker/mobile/proxy/web/Schedule/Today/Corridor/Lakeshore%20West'),
            fetchData('https://www.gotracker.ca/gotracker/mobile/proxy/web/Schedule/Today/Corridor/Lakeshore%20East'),
            fetchData('https://www.gotracker.ca/gotracker/mobile/proxy/web/Schedule/Today/Corridor/Barrie'),
            fetchData('https://www.gotracker.ca/gotracker/mobile/proxy/web/Schedule/Today/Corridor/Kitchener'),
            fetchData('https://www.gotracker.ca/gotracker/mobile/proxy/web/Schedule/Today/Corridor/Stouffville'),
            fetchData('https://www.gotracker.ca/gotracker/mobile/proxy/web/Schedule/Today/Corridor/Richmond%20Hill'),
            fetchData('https://www.gotracker.ca/gotracker/mobile/proxy/web/Schedule/Today/Corridor/Milton'),
            fetchData('https://www.gotracker.ca/gotracker/mobile/proxy/web/Info/TripPatterns/Train')
            ]);

            if (!LW || !LE || !BR || !GT || !ST || !RH || !MI || !tripCodes) {
                console.error("Critical data missing");
                return;
            }

            // mark initial load completed when all three main files are present
            this.initialLoaded = true;

            codesData = tripCodes;
            // Step 2: Get locked station candidates
            const combinedTrips = LW.commitmentTrip.concat(LE.commitmentTrip, BR.commitmentTrip, GT.commitmentTrip, ST.commitmentTrip, RH.commitmentTrip, MI.commitmentTrip);
            const rawLockedStations = processLockedStations(combinedTrips, tripCodes);
            this.alllockedStationVehicleIds = [];
            rawLockedStations.forEach(b => b.vehicles.forEach(v => this.alllockedStationVehicleIds.push(v)));

            // Step 3: Check "Active" status for locked stations
            const activeLockedStations = await Promise.all(rawLockedStations.map(async (b) => {
            const path = `https://www.gotracker.ca/gotracker/mobile/proxy/web/Messages/Signage/Rail/${b.lineCode}/${b.stopCode}`;
                const lineData = await fetchData(path);
                
                let isActive = false;
                let activeVehiclesAtStop = new Set();

                if (lineData?.directions) {
                    lineData.directions.forEach(dir => {
                        dir.tripMessages.forEach(msg => {
                            if (b.vehicles.has(msg.tripName)) {
                                isActive = true;
                                activeVehiclesAtStop.add(msg.tripName);
                            }
                        });
                    });
                }

                return {
                    ...b,
                    isActive,
                    activeVehiclesAtStop
                };
            }));

            this.lockedStations = activeLockedStations.sort((a, b) => {
                return String(a.stationName).localeCompare(String(b.stationName), undefined, { sensitivity: 'base' });
            });

            // Reset pagination if content changed significantly? 
            // For now just render.
            this.render();
            lastSyncedTime = new Date().getTime();
        } catch (e) {
            console.error("Error during loadAndProcess:", e);
        } finally {
            this.fetchInProgress = false;
        }
    }

    render() {
        isLoaded = true;
        this.renderLockedStations();
    }

    renderLockedStations() {
		let c1 = window.lockedStationIds || [], c2 = window.activeLockedStationIds || [], c3 = window.affectedTrips || [];
        window.lockedStationIds = this.lockedStations.map(i=>i.atlsId);
        window.activeLockedStationIds = this.lockedStations.filter(i=>i.isActive).map(i=>i.atlsId);
        window.affectedTrips = this.alllockedStationVehicleIds;
		if (JSON.stringify(c1) != JSON.stringify(window.lockedStationIds) || JSON.stringify(c2) != JSON.stringify(window.activeLockedStationIds) || JSON.stringify(c3) != JSON.stringify(window.affectedTrips)) {
			plotAllStations();
		}
    }
}
