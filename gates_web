function removeMarkerLoop(removeAll){
    if (hasMarker){
        //var newMarker = new Object();
        var removeList = [];
        $.each(allMarker, function(key, value){            
            if (removeAll || value.isValid == false){
                removeList.push(value.key);
                removeMarker(value); 
                value = null;  
                delete value;         
            }
        });
        $.each(removeList, function(key, value){
            var idx = $.inArray(value, allMarkerKey);
            if (idx != -1) {
                allMarkerKey.splice(idx, 1);
                allMarker.splice(idx, 1);
            }
        });

        delete removeList;
        if (removeAll){
            hasMarker = false;
            allMarker = [];
            allMarkerKey = [];
        }
    }
}

