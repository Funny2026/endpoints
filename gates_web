/**
 * Fetch with per-endpoint timeout and unlimited retries until a successful JSON response is obtained.
 * Uses AbortController to cancel requests that exceed the endpoint-specific timeout.
 */
function getTimeoutForUrl(url) {
    // Define timeouts in milliseconds based on path substrings
    if (url.includes('/Schedule/Today/Corridor/Lakeshore%20West')) return 15000; // 15s
    if (url.includes('/Schedule/Today/Corridor/Lakeshore%20East')) return 15000; // 15s
    if (url.includes('/Schedule/Today/Corridor/Barrie')) return 15000; // 15s
    if (url.includes('/Schedule/Today/Corridor/Kitchener')) return 15000; // 15s
    if (url.includes('/Schedule/Today/Corridor/Stouffville')) return 15000; // 15s
    if (url.includes('/Schedule/Today/Corridor/Richmond%20Hill')) return 8000; // 8s
    if (url.includes('/Schedule/Today/Corridor/Milton')) return 10000; // 10s
    if (url.includes('/Info/TripPatterns/Train')) return 5000; // 5s
    if (url.includes('/Messages/Signage/Rail/')) return 1000; // 1s
    // default fallback
    return 8000;
}

async function fetchWithTimeout(url, ms, signal) {
    const controller = new AbortController();
    const combinedSignal = signal || controller.signal;
    const timeout = setTimeout(() => controller.abort(), ms);
    try {
        const response = await fetch(url, { signal: combinedSignal });
        clearTimeout(timeout);
        return response;
    } catch (err) {
        clearTimeout(timeout);
        throw err;
    }
}

async function fetchData(url) {
    while (true) {
        try {
            const timeoutMs = getTimeoutForUrl(url);
            let response;
            try {
                response = await fetchWithTimeout(url, timeoutMs);
            } catch (e) {
                // request timed out or aborted or network error - retry unlimited times
                continue;
            }

            // If gateway errors or bad gateway - retry
            if (response.status === 502 || response.status === 504 || response.status === 400) {
                continue;
            }

            // For other non-ok statuses, also retry until success
            if (!response.ok) {
                continue;
            }

            // Try to parse JSON - if parsing fails, retry
            try {
                return await response.json();
            } catch (e) {
                continue;
            }
        } catch (e) {
            // Swallow and retry indefinitely
            continue;
        }
    }
}

/**
 * Utility: find a stop name by numeric atlsId from tripCodes data.
 * Returns the stop name string or null if not found.
 */
function getStopNameByAtlsId(atlsId) {
    // Validate inputs
    if (!codesData || atlsId === null || atlsId === undefined || atlsId === "") return null;

    // Normalize for comparison: attempt numeric comparison first, otherwise compare as strings
    const targetNum = Number(atlsId);
    const useNumericCompare = !Number.isNaN(targetNum);

    for (const line of codesData) {
        if (!line.routes) continue;
        for (const route of line.routes) {
            if (!route.stops) continue;
            for (const stop of route.stops) {
                if (useNumericCompare) {
                    if (Number(stop.atlsId) === targetNum) {
                        return stop.name || null;
                    }
                } else {
                    if (String(stop.atlsId) === String(atlsId)) {
                        return stop.name || null;
                    }
                }
            }
        }
    }
    return null;
}



/**
 * Logic for Locked Stations
 *
 * Two detection methods:
 * 1) If a stop in the trip has isStopping="0" and a truthy schTrack value, treat that stop as locked (use the stop's provided name when available).
 * 2) The original scheduled-missing-stops method: compare scheduled stopOrder numbers and any missing order between first and last active stops is locked.
 */
function processLockedStations(tripsData, tripCodesData) {
    const lockedStationsResults = []; // { stationName, atlsId, vehicles: Set<string>, lineCode, stopCode }

    tripsData.forEach(trip => {
        // collect stops
        let stops = trip.stop || [];

       // Trim start and end array that have impossible values
        let startIndex = 0;
        while (startIndex < stops.length && (stops[startIndex].isStopping === "0" || stops[startIndex].isStopping === 0 || stops[startIndex].isStopping === false)) {
            startIndex++;
        }
    
        let endIndex = stops.length - 1;
        while (endIndex >= startIndex && (stops[endIndex].isStopping === "0" || stops[endIndex].isStopping === 0 || stops[endIndex].isStopping === false)) {
            endIndex--;
        }
    
        stops = stops.slice(startIndex, endIndex + 1);
        // active stops are those with isStopping === "1"
        const activeStops = stops.filter(s => s.isStopping === "1");

        // find pattern/line for this trip
        let patternCode = null;
        let lineData = null;
        for (const line of tripCodesData) {
            const tripMatch = line.trips.find(t => t.number === trip.tripNumber);
            if (tripMatch) {
                patternCode = tripMatch.patternCode;
                lineData = line;
                break;
            }
        }
        if (!patternCode || !lineData) return;

        const route = lineData.routes.find(r => r.patternCode === patternCode);
        if (!route) return;

        // 1) Handle stops explicitly marked as locked via isStopping="0" + schTrack truthy
        const explicitLockedStations = stops.filter(s => s.isStopping === "0" && s.schTrack);
        explicitLockedStations.forEach(s => {
            // try to get route info by atlsId if available
            const routeStop = route.stops.find(rs => rs.atlsId === s.id);
            const atlsId = routeStop ? routeStop.atlsId : (s.id || null);
            const name = s.name || (routeStop ? routeStop.name : 'Unknown');
            const code = routeStop ? routeStop.code : (s.code || null);

            let existing = lockedStationsResults.find(r => r.atlsId === atlsId && r.lineCode === lineData.code);
            if (!existing) {
                existing = {
                    stationName: name,
                    atlsId: atlsId,
                    vehicles: new Set(),
                    lineCode: lineData.code,
                    stopCode: code
                };
                lockedStationsResults.push(existing);
            }
            existing.vehicles.add(trip.tripNumber);
        });

        // 2) Original method — determine missing scheduled stopOrder numbers between first and last active stops
        const activeStopOrders = activeStops
            .map(s => {
                const routeStop = route.stops.find(rs => rs.atlsId === s.id);
                return routeStop ? routeStop.stopOrder : null;
            })
            .filter(order => order !== null)
            .sort((a, b) => a - b);

        if (activeStopOrders.length < 2) return;

        const minOrder = activeStopOrders[0];
        const maxOrder = activeStopOrders[activeStopOrders.length - 1];

        for (let i = minOrder + 1; i < maxOrder; i++) {
            if (!activeStopOrders.includes(i)) {
                const notOrderedStop = route.stops.find(rs => rs.stopOrder === i);
                if (notOrderedStop) {
                    let existing = lockedStationsResults.find(r => r.atlsId === notOrderedStop.atlsId && r.lineCode === lineData.code);
                    if (!existing) {
                        existing = {
                            stationName: notOrderedStop.name,
                            atlsId: notOrderedStop.atlsId,
                            vehicles: new Set(),
                            lineCode: lineData.code,
                            stopCode: notOrderedStop.code
                        };
                        lockedStationsResults.push(existing);
                    }
                    existing.vehicles.add(trip.tripNumber);
                }
            }
        }
    });
    return lockedStationsResults;
}
