                        setTimeout(function(){isAjaxReturned = true;}, mapTripErrorRetryInterval);
                    }
                    else {
                        mapTripCurrentErrorCount++;
                        isAjaxReturned = true;
                    }
                }
                else
                    isAjaxReturned = true;
            });
    } else {
        $.ajax({
            type: "GET",
            url: ajaxUrl,
            dataType: "xml",
            cache: false,
