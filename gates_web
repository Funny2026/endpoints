            }
        });
    }
}

function tripDataReturn(data) {
    isAjaxReturned = true;
    var noTripErrStr = "Currently no Service is available";
    var err = $(data).find("ErrMsg").text();
    if (err == ""){
        var result = $(data).find(tripNodeName);
        if (result.length > 0){
            //trace('return trips: ' + result.length);

            $.each(allMarker, function(key, value){
                value.isValid = false;
            });

            result.each(function () {
                var lat;
                var lon;
                var delay;
                var speed = 0;
                var isBus = false;
                var express = false;
                var trainMeet = false;
                var tsource;
                var toHideMarker = false;
                var tripName = '';
                var tripNum = '';

                tripName = $(this).attr('TripName');
                tripNum = $(this).attr('TripNumber');
                try{
                    toHideMarker = ($(this).attr('ToHideMarker')) == 'true'? true: false;
                } catch (e) {}
                if (toHideMarker == false) {
                    delay = 0;
                    lat = $(this).attr('Latitude');
                    lon = $(this).attr('Longitude');
                    try{
                        tsource = $(this).attr('Source');
                        if (tsource == 'B'){
                            isBus = true;
                        }
                    } catch(e){}

                    //speed = 0;
                    //try {
                    //    speed = parseInt($(this).attr('Speed'));
                    //} catch (e) { }
                    
                    try {
                        delay = parseInt($(this).attr('DelaySeconds')) / 60;
                    } catch (e) { }

                    if (tripId != "" || hastusTripId != "") {
                        if (lat == 0 && lon == 0) {
                            $("#err").text('No coordinates');
                            return;
                        }
                        if (panTrain == true){
                            PanTrainToPos(lat, lon);                            
                            panTrain = false;
                        }
                        else{
                            if (followControl != null && followControl != undefined){
                            panTrain = followControl.getFollow();
                            if (panTrain)
                                PanTrainToPos(lat, lon);
                            }
                        }
                    }
                    var rtn;
                    try {
                        //rtn = moveObj(moveMode + '_' + tripNum, tripName, tripNum, lat, lon, delay, speed, isBus);
                        rtn = moveObj(tripNum, this, isBus);
                    }
                    catch (e) { }
                    finally {
                        rtn = null;
                        delete rtn;
                    }
                }
            });
            removeMarkerLoop(false);
            noTripDataReturnCount = 0;
        }
        else{
            if (!firstLoad){
                if (noTripDataReturnCount < 5){
                    noTripDataReturnCount++;
                }
                else{
                    //trace('all marker to be removed');
                    removeMarkerLoop(true);
                    //trace('marker count after removing all of them: ' + trainMarker);
                    noTripDataReturnCount = 0;
                }
            }
            else{
                firstLoad = false;
                //if (raiseError != undefined && raiseError != null){
                //    raiseError(noTripErrStr + "," + err);
                //}
            }
        }
        result = null;
        waiting = false;
        if (firstLoad == true){
            firstLoad = false;
        }
    }
    else{
        if (firstLoad == true){
            firstLoad = false;
//            if (raiseError != undefined && raiseError != null){
//                raiseError(err);
//            }
        }
    }
    err = null;
    data = null;
    delete err;
    delete data;
}

